# ==========================================================
# Large CIFAR-10 Dataset
# ==========================================================

# Ignore the complete raw dataset
data/raw/*

# Keep these small/documentation files tracked
!data/raw/sample.csv
!data/raw/download_data.py
!data/raw/README.md

